<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="inventory">
        <createTable tableName="INV_CATEGORY">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(200)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="inventory">
        <createTable tableName="INV_PRODUCT">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="NAME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="varchar(500)"/>
            <column name="NOTE1" type="varchar(255)"/>
            <column name="NOTE2" type="varchar(255)"/>
            <column name="UNIT" type="varchar(50)" defaultValue="UNIDAD">
                <constraints nullable="false"/>
            </column>
            <column name="STOCK" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="CATEGORY_ID" type="${uuid.type}"/>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="inventory">
        <addForeignKeyConstraint baseTableName="INV_PRODUCT"
                                 baseColumnNames="CATEGORY_ID"
                                 constraintName="FK_INV_PRODUCT_CATEGORY"
                                 referencedTableName="INV_CATEGORY"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="4" author="inventory">
        <createIndex tableName="INV_PRODUCT" indexName="IDX_INV_PRODUCT_CODE" unique="true">
            <column name="CODE"/>
        </createIndex>
    </changeSet>

    <changeSet id="5" author="inventory">
        <createTable tableName="INV_STOCK_ENTRY">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="ENTRY_DATE" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="VOUCHER" type="varchar(100)"/>
            <column name="PRODUCT_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="varchar(500)"/>
            <column name="NOTE1" type="varchar(255)"/>
            <column name="NOTE2" type="varchar(255)"/>
            <column name="QUANTITY" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="REASON" type="varchar(500)"/>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="6" author="inventory">
        <addForeignKeyConstraint baseTableName="INV_STOCK_ENTRY"
                                 baseColumnNames="PRODUCT_ID"
                                 constraintName="FK_INV_ENTRY_PRODUCT"
                                 referencedTableName="INV_PRODUCT"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="7" author="inventory">
        <createTable tableName="INV_STOCK_EXIT">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EXIT_DATE" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="VOUCHER" type="varchar(100)"/>
            <column name="PRODUCT_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="varchar(500)"/>
            <column name="NOTE1" type="varchar(255)"/>
            <column name="NOTE2" type="varchar(255)"/>
            <column name="QUANTITY" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="REASON" type="varchar(500)"/>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="8" author="inventory">
        <addForeignKeyConstraint baseTableName="INV_STOCK_EXIT"
                                 baseColumnNames="PRODUCT_ID"
                                 constraintName="FK_INV_EXIT_PRODUCT"
                                 referencedTableName="INV_PRODUCT"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="9" author="inventory">
        <addColumn tableName="INV_CATEGORY">
            <column name="DESCRIPTION" type="varchar(500)"/>
        </addColumn>
        <addColumn tableName="INV_CATEGORY">
            <column name="ACTIVE" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="10" author="inventory">
        <addColumn tableName="INV_PRODUCT">
            <column name="ACTIVE" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="11" author="inventory">
        <createTable tableName="INV_EMPLOYEE">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DOCUMENT_ID" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="CARGO" type="varchar(255)"/>
            <column name="NOTE1" type="varchar(255)"/>
            <column name="NOTE2" type="varchar(255)"/>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="12" author="inventory">
        <createIndex tableName="INV_EMPLOYEE" indexName="IDX_INV_EMPLOYEE_DOCUMENT_ID" unique="true">
            <column name="DOCUMENT_ID"/>
        </createIndex>
    </changeSet>

    <changeSet id="13" author="inventory">
        <addColumn tableName="INV_STOCK_EXIT">
            <column name="EMPLOYEE_ID" type="${uuid.type}"/>
        </addColumn>
    </changeSet>

    <changeSet id="14" author="inventory">
        <addForeignKeyConstraint baseTableName="INV_STOCK_EXIT"
                                 baseColumnNames="EMPLOYEE_ID"
                                 constraintName="FK_INV_EXIT_EMPLOYEE"
                                 referencedTableName="INV_EMPLOYEE"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="16" author="inventory">
        <createTable tableName="INV_MEDIDA">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="DESCRIPTION" type="varchar(500)"/>
            <column name="ACTIVE" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="17" author="inventory">
        <addColumn tableName="INV_PRODUCT">
            <column name="MEDIDA_ID" type="${uuid.type}"/>
        </addColumn>
    </changeSet>

    <changeSet id="18" author="inventory">
        <addForeignKeyConstraint baseTableName="INV_PRODUCT"
                                 baseColumnNames="MEDIDA_ID"
                                 constraintName="FK_INV_PRODUCT_MEDIDA"
                                 referencedTableName="INV_MEDIDA"
                                 referencedColumnNames="ID"/>
    </changeSet>

    <changeSet id="15" author="inventory">
        <update tableName="INV_CATEGORY">
            <column name="ACTIVE" valueBoolean="true"/>
            <where>ACTIVE IS NULL</where>
        </update>
        <update tableName="INV_PRODUCT">
            <column name="ACTIVE" valueBoolean="true"/>
            <where>ACTIVE IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="19" author="inventory">
        <addColumn tableName="INV_PRODUCT">
            <column name="PART_NUMBER" type="varchar(100)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20" author="inventory">
        <insert tableName="INV_MEDIDA" dbms="postgresql, mssql, hsqldb">
            <column name="ID" value="a0000000-0000-0000-0000-000000000001"/>
            <column name="VERSION" value="1"/>
            <column name="NAME" value="UNIDAD"/>
            <column name="ACTIVE" valueBoolean="true"/>
        </insert>
        <insert tableName="INV_MEDIDA" dbms="oracle, mysql, mariadb">
            <column name="ID" value="a000000000000000000000000000001"/>
            <column name="VERSION" value="1"/>
            <column name="NAME" value="UNIDAD"/>
            <column name="ACTIVE" valueBoolean="true"/>
        </insert>
    </changeSet>


    <changeSet id="21" author="inventory">
        <addColumn tableName="INV_PRODUCT">
            <column name="MIN_STOCK" type="int" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="22" author="inventory">
        <addColumn tableName="INV_PRODUCT">
            <column name="ALERT_MARGIN" type="int" defaultValueNumeric="5"/>
        </addColumn>
    </changeSet>

    <changeSet id="23" author="inventory">
        <addColumn tableName="INV_STOCK_ENTRY">
            <column name="CANCELLED" type="boolean" defaultValueBoolean="false"/>
        </addColumn>
        <addColumn tableName="INV_STOCK_EXIT">
            <column name="CANCELLED" type="boolean" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
