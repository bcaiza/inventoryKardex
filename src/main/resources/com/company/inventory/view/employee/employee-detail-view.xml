<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://EmployeeDetailView.title"
      focusComponent="form">
    <data>
        <instance id="employeeDc" class="com.company.inventory.entity.Employee">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="employeeDc" labelsPosition="TOP">
            <textField id="documentIdField" property="documentId" required="true"
                       label="msg://com.company.inventory.entity/Employee.documentId" width="20em"/>
            <textField id="nameField" property="name" required="true"
                       label="msg://com.company.inventory.entity/Employee.name" width="30em"/>
            <textField id="cargoField" property="cargo"
                       label="msg://com.company.inventory.entity/Employee.cargo" width="30em"/>
            <textField id="note1Field" property="note1"
                       label="msg://com.company.inventory.entity/Employee.note1" width="100%"/>
            <textField id="note2Field" property="note2"
                       label="msg://com.company.inventory.entity/Employee.note2" width="100%"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
