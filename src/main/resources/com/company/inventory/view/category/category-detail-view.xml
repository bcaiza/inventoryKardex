<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://CategoryDetailView.title"
      focusComponent="form">
    <data>
        <instance id="categoryDc" class="com.company.inventory.entity.Category">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="categoryDc" labelsPosition="TOP">
            <textField id="nameField" property="name" required="true" width="30em"/>
            <checkbox id="activeField" property="active" required="false" label="msg://com.company.inventory.entity/Category.active"/>
            <textArea id="descriptionField" property="description" colspan="2"
                      label="msg://com.company.inventory.entity/Category.description" width="100%"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
