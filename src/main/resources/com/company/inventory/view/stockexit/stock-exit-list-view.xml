<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://StockExitListView.title"
      focusComponent="stockExitsDataGrid">
    <data>
        <collection id="stockExitsDc" class="com.company.inventory.entity.StockExit">
            <fetchPlan extends="_base">
                <property name="product" fetchPlan="_base">
                    <property name="medida" fetchPlan="_base"/>
                </property>
                <property name="employee" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="stockExitsDl" readOnly="true">
                <query>
                    <![CDATA[select e from StockExit e order by e.exitDate desc, e.createdDate desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter" dataLoader="stockExitsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="stockExitsDataGrid.createAction"/>
            <button id="bulkImportButton" text="msg://bulkImport"/>
            <button id="anularButton" text="msg://anularButton" themeNames="error"/>
            <button id="excelExportBtn" action="stockExitsDataGrid.excelExport"/>
            <simplePagination id="pagination" dataLoader="stockExitsDl"/>
        </hbox>
        <dataGrid id="stockExitsDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  selectionMode="MULTI"
                  dataContainer="stockExitsDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="excelExport" type="grdexp_excelExport"/>
            </actions>
            <columns resizable="true">
                <column property="cancelled" width="110px"/>
                <column property="exitDate" width="130px"/>
                <column property="product.name" width="280px"/>
                <column property="product.category" width="280px"/>
                <column property="product.medida" width="140px"/>
                <column property="employee" width="180px"/>
                <column property="quantity" width="110px"/>
                <column property="reason" width="220px"/>
                <column property="createdDate" width="170px"/>
                <column property="createdBy" width="150px"/>
                <column property="lastModifiedBy" width="150px"/>
                <column property="lastModifiedDate" width="170px"/>
            </columns>
        </dataGrid>
    </layout>
</view>
