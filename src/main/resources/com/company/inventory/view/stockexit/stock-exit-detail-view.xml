<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://StockExitDetailView.title"
      focusComponent="form">
    <data>
        <instance id="stockExitDc" class="com.company.inventory.entity.StockExit">
            <fetchPlan extends="_base">
                <property name="product" fetchPlan="_base"/>
                <property name="employee" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
        <collection id="productsDc" class="com.company.inventory.entity.Product">
            <fetchPlan extends="_base"/>
            <loader id="productsDl">
                <query><![CDATA[select e from Product e order by e.code]]></query>
            </loader>
        </collection>
        <collection id="employeesDc" class="com.company.inventory.entity.Employee">
            <fetchPlan extends="_base"/>
            <loader id="employeesDl">
                <query><![CDATA[select e from Employee e order by e.name]]></query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <vbox id="stockInfoBox" padding="false" spacing="false">
            <span id="currentStockSpan" />
        </vbox>
        <formLayout id="form" dataContainer="stockExitDc" labelsPosition="TOP">
            <datePicker id="exitDateField" property="exitDate" required="true"
                        label="msg://com.company.inventory.entity/StockExit.exitDate"/>
            <textField id="voucherField" property="voucher"
                       label="msg://com.company.inventory.entity/StockExit.voucher"/>
            <entityComboBox id="productField" property="product" required="true" colspan="2"
                            label="msg://com.company.inventory.entity/StockExit.product"
                             width="100%"
                            itemsContainer="productsDc"/>
            <integerField id="quantityField" property="quantity" required="true" min="1"
                          label="msg://com.company.inventory.entity/StockExit.quantity"/>
            <entityComboBox id="employeeField" property="employee" colspan="2"
                            label="msg://com.company.inventory.entity/StockExit.employee"
                             width="100%"
                            itemsContainer="employeesDc"/>
            <textArea id="descriptionField" property="description" colspan="2"
                      label="msg://com.company.inventory.entity/StockExit.description" width="100%"/>
            <textField id="note1Field" property="note1"
                       label="msg://com.company.inventory.entity/StockExit.note1"/>
            <textField id="note2Field" property="note2"
                       label="msg://com.company.inventory.entity/StockExit.note2"/>
            <textArea id="reasonField" property="reason" colspan="2"
                      label="msg://com.company.inventory.entity/StockExit.reason" width="100%"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
